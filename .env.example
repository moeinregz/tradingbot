# ---- Database: MongoDB Atlas (free M0 cluster) ----
# Atlas > Connect > Drivers. In Network Access allow 0.0.0.0/0 (Vercel has no fixed IPs).
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=stepbot

# ---- Dashboard login ----
ADMIN_USERNAME=admin
# generate with: npm run hash-password -- "your strong password"
ADMIN_PASSWORD_HASH=
# random string, at least 32 chars (e.g. `openssl rand -hex 32`)
SESSION_SECRET=
# optional: fixed TOTP secret; if empty you enroll 2FA with a QR code on first login
TOTP_SECRET=

# ---- Engine scheduler ----
# the cron endpoint /api/cron/tick requires this as "Authorization: Bearer <CRON_SECRET>" or ?secret=
CRON_SECRET=
# ticks per cron call and seconds between them (3 x 15s ≈ one call per minute)
TICKS_PER_RUN=3
TICK_INTERVAL_SEC=15

# ---- Paper trading ----
# nobitex = real public prices from Nobitex, simulated = random walk (demo when Nobitex is unreachable)
PAPER_PRICE_SOURCE=nobitex
PAPER_SIM_START_PRICE=1050000

# ---- Live trading (keep disabled until paper results are verified) ----
LIVE_TRADING_ENABLED=false
# Nobitex API token WITHOUT withdrawal permission
NOBITEX_API_TOKEN=
NOBITEX_BASE_URL=https://apiv2.nobitex.ir
NOBITEX_USER_AGENT=TraderBot/StepLadderBot
